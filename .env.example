# Free default: Google Sheet webhook from scripts/pci-launch-sheet.gs
GOOGLE_SHEETS_WEBHOOK_URL=

# Optional. When all three are set, /api/subscribe also writes to Mailchimp "PCI Launch".
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=

# Optional public GoFundMe URL for "Build the Park City Incline"
NEXT_PUBLIC_GOFUNDME_URL=
